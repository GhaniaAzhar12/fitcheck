# Neon → your project → Connect → copy the connection string.
# Locally: pooling off (direct). On Vercel: pooling on (host has -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full"

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3005"

# GitHub OAuth app (github.com/settings/developers)
# Callback URL: http://localhost:3005/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# AI model: ollama | google | anthropic
AI_PROVIDER="ollama"
# Optional. Defaults: qwen2.5:7b, gemini-3.5-flash-lite, claude-haiku-5-5
AI_MODEL=""
# Optional, only for Ollama on another machine
# OLLAMA_BASE_URL="http://localhost:11434/api"
# Only needed for the matching provider
GOOGLE_GENERATIVE_AI_API_KEY=""
ANTHROPIC_API_KEY=""

# Stripe, TEST MODE ONLY (live keys are refused). dashboard.stripe.com → a
# sandbox → Developers → API keys (or `stripe sandboxes create`, rkcs_test_).
# A restricted key (rk_test_) with write access to Checkout Sessions is
# safest; sk_test_ also works.
STRIPE_SECRET_KEY=""
# Locally: run `stripe listen --forward-to localhost:3005/api/stripe/webhook`
# and paste the whsec_ it prints. On Vercel: the endpoint's signing secret.
STRIPE_WEBHOOK_SECRET=""
