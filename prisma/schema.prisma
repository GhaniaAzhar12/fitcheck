generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth tables (core schema) ────────────────────────────────────────

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  jobs          Job[]
  profile       Profile?
  usageEvents   UsageEvent[]
  creditEntries CreditEntry[]
  cvChunks      CvChunk[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Fitcheck ────────────────────────────────────────────────────────────────

/// One per user: what the agent searches for evidence.
model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Plain text pulled from the uploaded CV. The PDF itself is not stored.
  cvText     String?
  cvFileName String?
  cvPages    Int?
  /// GitHub repos chosen as evidence, as "owner/name".
  repos      String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("profile")
}

enum JobStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

model Job {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  url         String?
  rawText     String
  /// Structured requirements pulled out by the model (JobExtraction schema)
  extracted   Json?
  status      JobStatus    @default(SAVED)
  /// When to chase this application next (tracker)
  followUpAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  analyses    Analysis[]
  usageEvents UsageEvent[]

  @@index([userId, createdAt])
  @@map("job")
}

enum AnalysisStatus {
  DONE
  FAILED
}

/// One evidence-agent run for a job. Every run is kept, including failures.
model Analysis {
  id           String         @id @default(cuid())
  jobId        String
  job          Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status       AnalysisStatus
  /// Evidence[] (see lib/agent/evidence.ts)
  evidence     Json?
  /// ToolCallLog[]: every tool call the agent made
  toolCalls    Json?
  /// Written fit report (Day 13)
  report       String?
  /// Tailored CV bullets + cover note (lib/saved-tailoring.ts)
  tailored     Json?
  /// Interview questions and answers (lib/saved-tailoring.ts)
  interview    Json?
  /// 0–100, weighted from the evidence
  score        Int?
  provider     String
  model        String
  inputTokens  Int            @default(0)
  outputTokens Int            @default(0)
  steps        Int            @default(0)
  ms           Int
  error        String?
  createdAt    DateTime       @default(now())

  @@index([jobId, createdAt])
  @@map("analysis")
}

enum UsageKind {
  EXTRACT
  ANALYSIS
  REPORT
  TAILOR
  INTERVIEW
  KEY_CHECK
  /// Turning CV chunks or search queries into vectors (lib/cv-embeddings.ts)
  EMBED
}

/// One AI model call: what it cost in tokens and time. Powers the cost
/// panel, /usage and the daily free-analysis limit.
model UsageEvent {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null for calls not tied to a saved job (e.g. a key check).
  jobId        String?
  job          Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  kind         UsageKind
  provider     String
  model        String
  /// True when the visitor's own API key paid for the call.
  ownKey       Boolean   @default(false)
  /// True when a bought credit paid for this analysis (not the free allowance).
  credit       Boolean   @default(false)
  ok           Boolean   @default(true)
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  ms           Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([jobId])
  @@map("usage_event")
}

enum CreditReason {
  PURCHASE
  ANALYSIS
  REFUND
}

/// The credits ledger: +10 per pack bought, -1 per paid analysis, +1 back if
/// that analysis fails. The balance is the sum of delta, so every change is
/// on record. Stripe test mode only: no real money.
model CreditEntry {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta           Int
  reason          CreditReason
  /// The Checkout Session that paid for a pack. Unique, so a webhook that
  /// arrives twice can't add the credits twice.
  stripeSessionId String?      @unique
  jobId           String?
  createdAt       DateTime     @default(now())

  @@index([userId, createdAt])
  @@map("credit_entry")
}

/// One searchable piece of a user's CV (a bullet or paragraph), with its
/// embedding for meaning-based search. Replaced whenever the CV is uploaded.
/// Vectors are written with raw SQL (lib/cv-chunks.ts).
model CvChunk {
  id        String                      @id @default(cuid())
  userId    String
  user      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Order in the CV, from 0.
  position  Int
  section   String?
  text      String
  /// Null until embedded, or when embedding failed.
  embedding Unsupported("vector(768)")?
  /// Which model made the vector, e.g. "google:gemini-embedding-001".
  model     String?
  createdAt DateTime                    @default(now())

  @@index([userId])
  @@map("cv_chunk")
}
